#!/bin/sh

xresource() {
    xrdb -query |
      grep -m1 -E "^screensaver\.${1//./\\.}" |         # first matching line
      sed -r 's/^[^:]+:[[:space:]]+//'                  # strip “KEY: ” prefix
}

# Read configuration from Xresources (with sane defaults)
timeout=$(xresource lock)   ; timeout=${timeout:-600}   # seconds until lock
dim=$(xresource dim)        ; dim=${dim:-0}             # seconds until dim
dpms=$(xresource dpms)      ; dpms=${dpms:-900}         # DPMS standby time

# Detect AC power. Returns 0 on AC, 1 on battery / unknown.
is_on_ac_power() {
    for ac_path in /sys/class/power_supply/AC{,AD,C0,DP1}/online; do
        [ -r "$ac_path" ] || continue
        [ "$(cat "$ac_path")" = 1 ] && return 0
    done

    # default: not on AC
    return 1
}

# Apply xset screensaver + DPMS settings
configure() {
    if [ "$dim" -eq 0 ]; then
        # Set only a (default) lock timeout
        xset s "$timeout"
    else
        # Set a dim + lock timeout
        xset s "$dim" "$timeout"
    fi

    if [ "$dpms" -gt 0 ]; then
        # Enable DPMS
        xset dpms "$dpms" $((dpms*12/10)) $((dpms*14/10))
    else
        # Disable DPMS
        xset -dpms
    fi
}

case "$1" in
    start)
        configure

        if [ "$dim" -eq 0 ]; then
            exec xss-lock --session=${XDG_SESSION_ID} --transfer-sleep-lock "$0" lock
        else
            exec xss-lock --session=${XDG_SESSION_ID} --notifier="$0 dim" --transfer-sleep-lock "$0" lock
        fi
        ;;

    dim)
        trap "exit 0" TERM INT

        if command -v xbacklight &>/dev/null && ! is_on_ac_power; then
            # Return to current brightness on exit
            trap "xbacklight -fps 30 -set $(xbacklight -get); kill %%" EXIT

            # Reduce brightness to 1%
            xbacklight -fps 15 -set 1

            # Wait until exit
            sleep infinity &
            wait
        fi
        ;;

    lock)
        # Restore the screensaver timeouts
        configure

        # Pause any music players
        command -v playerctl >/dev/null 2>&1 && playerctl -a pause

        # Pause the notification daemon
        dunstctl_state=$(dunstctl is-paused)
        dunstctl set-paused true

        # Launch i3lock, it will close the inherited sleep-lock
        i3lock --show-failed-attempts --nofork \
            --image="$HOME/.local/wallpapers/${HOST}-lock.png"

        # Restore notifications
        dunstctl set-paused "${dunstctl_state}"
        ;;
esac

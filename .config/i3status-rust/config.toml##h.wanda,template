###############################################################
#  i3status-rust – Arc-Darker flavoured                       #
###############################################################
#
# Generated by processing {{ yadm.source }}

{% include "include/general" %}

{% include "include/cpu-usage" %}

{% include "include/cpu-temp" %}
info        = 70
warning     = 85

{% include "include/mem-zram" %}

# -- Backlight
[[block]]
block       = "backlight"
device      = "intel_backlight"
format      = " $icon $brightness "

# -- Volume with click-to-mute
[[block]]
block       = "sound"
driver      = "pulseaudio"
max_vol     = 200
format      = " $icon {$volume.eng(w:2) |}"
show_volume_when_muted  = true
headphones_indicator    = true

# -- Battery
[[block]]
block       = "battery"
interval    = 30
full_format = " $icon ($percentage) "
empty_format = " $icon $time_remaining ($percentage) "
format      = " $icon $time_remaining ($percentage) "
info        = -1

# -- Unified wired / wireless network
[[block]]
block       = "net"
device      = "^(enp.*|wlp.*)$"
interval    = 2
format      = " $icon {$signal_strength ($bitrate) @ $ssid $frequency|wired via $device} "
format_alt  = " $icon $device: $ip ↓$speed_down.eng(u:b,p:K,w:4) ↑$speed_up.eng(u:b,p:K,w:4) "

{% include "include/clock" %}


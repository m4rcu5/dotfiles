# -- Memory with zram info
[[block]]
block       = "memory"
format      = " $icon $mem_used.eng(prefix:Mi)/$mem_total.eng(prefix:Mi) ($mem_used_percents.eng(w:2)) "
format_alt  = " $icon Used: $mem_used.eng(prefix:Mi) (Buff: $buffers.eng(prefix:Mi) + Cache: $cached.eng(prefix:Mi)) {$icon_swap ZRam: $zram_compressed.eng(prefix:Mi,range:1..)|} "

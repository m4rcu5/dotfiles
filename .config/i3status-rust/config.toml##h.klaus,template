###############################################################
#  i3status-rust – Arc-Darker flavoured                       #
###############################################################
#
# Generated by processing {{ yadm.source }}

{% include "include/general" %}

{% include "include/cpu-usage" %}

# -- CPU load avg
[[block]]
block       = "load"
format      = " avg: $1m.eng(w:4), $5m.eng(w:4), $15m.eng(w:4) "

{% include "include/cpu-temp" %}
good        = 35
idle        = 55
info        = 75
warning     = 85
chip        = "coretemp-isa-0000"

{% include "include/mem-zram" %}

# -- Wired network
[[block]]
block       = "net"
device      = "^(enp.*|vpn.*)$"
interval    = 2
format      = " $icon $device: $ip ↓$speed_down.eng(u:b,p:K,w:4) ↑$speed_up.eng(u:b,p:K,w:4) "

# -- VPN
[[block]]
block       = "net"
device      = "^(vpn.*)$"
interval    = 2
format      = " $icon $device: $ip ↓$speed_down.eng(u:b,p:K,w:4) ↑$speed_up.eng(u:b,p:K,w:4) "

{% include "include/clock" %}

[Unit]
Description=Restore color settings on webcam
Requires=sys-devices-pci0000:00-0000:00:14.0-usb1-1\x2d12-1\x2d12:1.3-sound-card3-controlC3.device
After=sys-devices-pci0000:00-0000:00:14.0-usb1-1\x2d12-1\x2d12:1.3-sound-card3-controlC3.device

[Service]
Type=oneshot
Environment="CAM=/dev/video0"

# Wait until the camera is initialized
ExecStartPre=/bin/sleep 5

# Restore color settings
ExecStart=/usr/bin/v4l2-ctl -d ${CAM} --set-ctrl=backlight_compensation=2,gain=6
ExecStart=/usr/bin/v4l2-ctl -d ${CAM} --set-ctrl=contrast=40,saturation=68,hue=-5,sharpness=4
RemainAfterExit=true

[Install]
WantedBy=default.target


" use 'vim-like' behaviour where removing a line here makes the setting disappear
sanitise tridactyllocal tridactylsync

" hide all gui elements
guiset_quiet gui none

" show the navbar
guiset_quiet navbar always

" move the hoverlink to the right
guiset_quiet hoverlink right

" hide the mode indicator when in Ignore mode
set modeindicatormodes {"ignore":"false"}

" maximum number of Ex commands and find patterns to store in the command-line history
set historyresults 1000

" set editorcmd to vim via i3-sensible-terminal, or use the defaults on other platforms
js tri.browserBg.runtime.getPlatformInfo().then(os=>{const editorcmd = os.os=="linux" ? "i3-sensible-terminal -e vim -t tridactyl-vim" : "auto"; tri.config.set("editorcmd", editorcmd)})

" sane hinting mode
set hintfiltermode vimperator-reflow
set hintnames numeric

" where to open related and new tabs
set relatedopenpos related
set tabopenpos last

" prevent websites from stealing focus
autocmd TabEnter .* unfocus

" allow Ctrl-a to select all in the commandline
unbind --mode=ex <C-a>

" allow Ctrl-c to copy in the commandline
unbind --mode=ex <C-c>

" handy multiwindow/multitasking binds
bind gd tabdetach
bind gD composite tabduplicate | tabdetach

" use the build-in search function as long as `find()` is not working properly
" unbinds <C-f> from scrolling, use <C-d> instead
unbind <C-f>

" find a likely next/previous link and follow it (in current tab)
bind ]] followpage next

" skip javascript hints on youtube
" disable hints for invisible elements (no js hinting)
bindurl youtu((\.be)|(be\.com)) f hint -J
bindurl youtu((\.be)|(be\.com)) F hint -b -J
bindurl youtu((\.be)|(be\.com)) tf hint -t -J

" limit selectable links on google
" https://github.com/glacambre/.dotfiles/blob/master/default/.config/tridactyl/tridactylrc
bindurl google(\.[a-zA-Z0-9]+){1,2}/search f hint -Jc #top_nav a, #search a, .card-section a, a.fl, #pnnext, #pnprev
bindurl google(\.[a-zA-Z0-9]+){1,2}/search F hint -Jbc #top_nav a, #search a, .card-section a, a.fl, #pnnext, #pnprev
bindurl google(\.[a-zA-Z0-9]+){1,2}/search gf hint -Jtc #top_nav a, #search a, .card-section a, a.fl, #pnnext, #pnprev
bindurl google(\.[a-zA-Z0-9]+){1,2}/search gF hint -Jqbc #top_nav a, #search a, .card-section a, a.fl, #pnnext, #pnprev

" disable all default searchurls
jsb Object.keys(tri.config.get("searchurls")).reduce((prev, u) => prev.catch(()=>{}).then(_ => tri.excmds.setnull("searchurls." + u)), Promise.resolve())

" add our own search engines
set searchurls.ddg https://duckduckgo.com/html?q=%s
set searchurls.google https://www.google.com/search?q=%s
set searchurls.gimages https://www.google.com/search?q=%s&tbm=isch
set searchurls.gmaps https://www.google.com/maps/search/%s
set searchurls.github https://github.com/search?utf8=%E2%9C%93&q=%s&ref=simplesearch
set searchurls.osm https://www.openstreetmap.org/search?query=%s
set searchurls.reddit https://old.reddit.com/r/%s
set searchurls.searxbe https://searx.be/?q=%s&categories=general&language=en-US
set searchurls.wikipedia https://en.wikipedia.org/w/index.php?search=%s&title=Special%3ASearch
set searchurls.youtube https://www.youtube.com/results?search_query=%s

" default to Google as search engine
set searchengine google


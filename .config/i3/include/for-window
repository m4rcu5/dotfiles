######################
# Per window options #
######################

# floating windows: per role
for_window [window_role="app"]                          floating enable
for_window [window_role="pop-up"]                       floating enable
for_window [window_role="task_dialog"]                  floating enable

# floating windows: per title
for_window [title="Preferences$"]                       floating enable
for_window [title="(?:Open|Save) (?:File|Folder|As)"]   floating enable

# floating windows: per applocation
for_window [class="(?i)blueman-manager"]                floating enable
for_window [class="(?i)nm-connection-editor"]           floating enable
for_window [class="(?i)pavucontrol"]                    floating enable
for_window [class="(?i)pcmanfm"]                        floating enable
for_window [class="(?i)file-roller"]                    floating enable
for_window [class="(?i)(?:own|next)cloud"]              floating enable
for_window [class="(?i)1Password"]                      floating enable
for_window [class="(?i)vlc"]                            floating enable
for_window [class="(?i)feh"]                            floating enable

# app: LibreWolf (float all except browser itself)
for_window [class="librewolf-(?:.*)"]                           floating enable
for_window [class="librewolf-(?:.*)" window_role="browser"]     floating disable

# app: Thunderbird
for_window [class="(?i)thunderbird" window_role="Msgcompose"]   floating enable
for_window [class="(?i)thunderbird" instance="Enigmail"]        floating enable

# app: Zoom
for_window [class="zoom"]                               floating enable
for_window [class="zoom"] [title="Chat"]                move position mouse
for_window [class="zoom"] [title="Settings"]            move position center

# i3 config file (v4)
#
# Generated by processing {{ yadm.source }}

# set modifier key to 'windows'
set $mod Mod4

# font for window titles.
set $win-font pango:Source Sans Pro 10

# font for the status bar
set $bar-font pango:Source Code Pro, Awesome 11

{% include "include/general" %}

{% include "include/bind-exec" %}

{% include "include/bind-screenshot" %}

{% include "include/bind-dunst" %}

{% include "include/window-focus" %}

####################
# Workspace naming #
####################

set $ws1 1 
set $ws2 2 
set $ws3 3 _
set $ws4 4 
    assign [class="^(?i)(Ferdium)$"] $ws4
set $ws5 5 
set $ws6 6 
set $ws7 7 
set $ws8 8 
set $ws9 9 
    assign [class="^(?i)org.remmina.Remmina$"] $ws9
    assign [class="^(?i)(VirtualBox (Machine|Manager))$"] $ws9
set $ws10 10 
    assign [class="^(?i)(Mail|Thunderbird(-esr)?)$"] $ws10

#######################
# Display assignments #
#######################
set $dp_left  DP-1
set $dp_right DP-3

workspace "$ws1" output $dp_left
workspace "$ws2" output $dp_left
workspace "$ws3" output $dp_left
workspace "$ws4" output $dp_left
workspace "$ws5" output $dp_left
workspace "$ws6" output $dp_right
workspace "$ws7" output $dp_right
workspace "$ws8" output $dp_right
workspace "$ws9" output $dp_right
workspace "$ws10" output $dp_right

{% include "include/bind-workspace" %}

{% include "include/mode-xrandr.{{ yadm.hostname }}" %}

{% include "include/mode-resize" %}

{% include "include/mode-system" %}

{% include "include/mode-media" %}

{% include "include/scratchpad" %}

{% include "include/for-window" %}

{% include "include/color-scheme.arc-darker" %}

#########
# i3bar #
#########
bar {
  mode dock
  position bottom

  font $bar-font
  status_command i3status

{% include "include/bar-colors" %}
}


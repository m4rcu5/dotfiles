# i3 config file (v4)
#
# Generated by processing {{ yadm.source }}

# set modifier key to 'windows'
set $mod Mod4

# font for window titles.
set $win-font pango:Source Sans Pro 10

# font for the status bar
set $bar-font pango:Source Code Pro, Awesome 11

{% include "include/general %}

{% include "include/bind-exec %}

{% include "include/bind-screenshot %}

{% include "include/bind-dunst %}

{% include "include/window-focus %}

####################
# Workspace naming #
####################

set $ws1 1 
set $ws2 2 
    assign [class="^(rambox|hamsket|[fF]erdi)$"] $ws2
set $ws3 3 
set $ws4 4 
set $ws5 5 
set $ws6 6 
set $ws7 7 
set $ws8 8 
    assign [class="^(akregator|Icedove|Mail|Thunderbird)$"] $ws8
set $ws9 9 
    assign [class="^VirtualBox (Machine|Manager)$"] $ws9
        for_window [class="^VirtualBox (Machine|Manager)$"] floating disable border none
set $ws10 10 

{% include "include/bind-workspace %}

{% include "include/mode-resize %}
{% include "include/mode-system %}
{% include "include/mode-media %}

{% include "include/scratchpad %}

{% include "include/for-window %}

{% include "include/color-scheme.arc-darker" %}

#########
# i3bar #
#########
bar {
  mode dock
  position bottom

  font $bar-font
  status_command i3status

{% include "include/bar-colors" %}
}

